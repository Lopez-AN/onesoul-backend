{
  "get_users_by_type": {
    "UserType": {
      "required": true,
      "type": "string",
      "regex": "~^(Guide|Seeker)$~"
    }
  },
  "get_users_by_category": {
    "CategoryID": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 65000
    }
  },
  "get_user_by_id": {
    "UserID": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999999
    }
  },
  "get_user_by_email": {
    "Email": {
      "required": true,
      "type": "email"
    }
  },
  "get_user_by_username": {
    "UserName": {
      "required": true,
      "type": "string",
      "regex": "~^[a-zA-Z0-9_]{1,15}$~"
    }
  },
  "get_user_by_referral_code": {
    "ReferralCode": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Z0-9]{6}$~"
    }
  },
  "update_user": {
    "UserID": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999999
    },
    "FirstName": {
      "required": false,
      "type": "string",
      "minlength": 2,
      "maxlength": 50
    },
    "LastName": {
      "required": false,
      "type": "string",
      "minlength": 2,
      "maxlength": 50
    },
    "DisplayName": {
      "required": false,
      "type": "string",
      "minlength": 2,
      "maxlength": 50
    },
    "Email": {
      "required": false,
      "type": "email",
      "maxlength": 100
    },
    "Phone": {
      "required": false,
      "type": "string",
      "minlength": 8,
      "maxlength": 20,
      "regex": "~^\\+[0-9]+$~"
    },
    "DateOfBirth": {
      "required": false,
      "type": "date"
    },
    "Gender": {
      "required": false,
      "type": "string",
      "regex": "~^(M|F|O)$~"
    },
    "Biography": {
      "required": false,
      "type": "string",
      "minlength": 10,
      "maxlength": 5000
    },
    "UserType": {
      "required": false,
      "type": "string",
      "regex": "~^(Guide|Seeker)$~"
    },
    "SignedContract": {
      "required": false,
      "type": "string",
      "maxlength": 255,
      "regex": "~^https?:\\/\\/.+~"
    },
    "LegalDocuments": {
      "required": false,
      "type": "string",
      "maxlength": 255,
      "regex": "~^https?:\\/\\/.+~"
    },
    "ShortDescription": {
      "required": false,
      "type": "string",
      "minlength": 10,
      "maxlength": 100
    },
    "Location": {
      "required": false,
      "type": "object"
    }
  },
  "user_location": {
    "LocationID": {
      "required": true,
      "type": "integer",
      "min": 1,
      "max": 99
    },
    "LocationName": {
      "required": false,
      "type": "string",
      "min": 0,
      "max": 30
    },
    "AddressName": {
      "required": false,
      "type": "string",
      "minlength": 3,
      "maxlength": 100
    },
    "AddressNumber": {
      "required": false,
      "type": "integer",
      "min": 1,
      "max": 99999
    },
    "Floor": {
      "required": false,
      "type": "integer",
      "min": 0,
      "max": 999
    },
    "Department": {
      "required": false,
      "type": "string",
      "minlength": 1,
      "maxlength": 4
    },
    "Cp": {
      "required": false,
      "type": "string",
      "minlength": 3,
      "maxlength": 10,
      "regex": "~^[0-9A-Z\\s-]+$~"
    },
    "City": {
      "required": false,
      "type": "string",
      "minlength": 2,
      "maxlength": 50
    },
    "State": {
      "required": false,
      "type": "string",
      "minlength": 2,
      "maxlength": 50
    },
    "CountryCode": {
      "required": false,
      "type": "string",
      "regex": "~^[A-Z]{2}$~"
    },
    "IsActive": {
      "required": false,
      "type": "boolean"
    }
  },
  "user_settings": {
    "ReceiveNewsletters": {
      "required": true,
      "type": "boolean"
    },
    "TimeZone": {
      "required": true,
      "type": "string",
      "regex": "~^(?:[A-Za-z_]+)(?:/[A-Za-z0-9._+-]+)+$~"
    },
    "PreferredLanguage": {
      "required": true,
      "type": "string",
      "regex": "~^[a-z]{2}$~"
    },
    "ViewMode": {
      "required": true,
      "type": "string",
      "regex": "~^(Light|Dark)$~"
    },
    "Notifications": {
      "required": false,
      "type": "object"
    }
  },
  "user_notifications": {
    "WhatsApp": {
      "required": true,
      "type": "boolean"
    },
    "Sms": {
      "required": true,
      "type": "boolean"
    },
    "PushApp": {
      "required": true,
      "type": "boolean"
    },
    "PushWeb": {
      "required": true,
      "type": "boolean"
    }
  }
}