{
  "checkuser": {
    "UserID": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999999
    }
  },
  "get_schedule_by_uuid": {
    "AssocUUID": {
      "required": true,
      "type": "string",
      "regex": "~^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$~"
    }
  },
  "register_schedule_intent": {
    "AssocUUID": {
      "required": true,
      "type": "string",
      "regex": "~^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$~"
    }
  },
  "get_availability": {
    "UserID": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999999
    }
  },
  "update_availability": {
    "UserID": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999999
    },
    "Monday": {
      "required": false,
      "type": "object"
    },
    "Tuesday": {
      "required": false,
      "type": "object"
    },
    "Wednesday": {
      "required": false,
      "type": "object"
    },
    "Thursday": {
      "required": false,
      "type": "object"
    },
    "Friday": {
      "required": false,
      "type": "object"
    },
    "Saturday": {
      "required": false,
      "type": "object"
    },
    "Sunday": {
      "required": false,
      "type": "object"
    }
  },
  "update_availability_day": {
    "StartTime": {
      "required": true,
      "type": "string",
      "regex": "~^([01][0-9]|2[0-3]):[0-5][0-9]$~"
    },
    "EndTime": {
      "required": true,
      "type": "string",
      "regex": "~^([01][0-9]|2[0-3]):[0-5][0-9]$~"
    }
  }
}
