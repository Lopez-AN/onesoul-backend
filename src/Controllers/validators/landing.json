{
  "get_contact_info": {
    "FromDate": {
      "required": false,
      "type": "date"
    },
    "ToDate": {
      "required": false,
      "type": "date"
    }
  },
  "send_contact_info": {
    "Role": {
      "required": true,
      "type": "string",
      "regex": "~(Guide|Seeker)~"
    },
    "Name": {
      "required": true,
      "type": "string",
      "maxlength": 100
    },
    "Email": {
      "required": true,
      "type": "email",
      "maxlength": 100
    },
    "Phone": {
      "required": false,
      "type": "string",
      "regex": "~^(\\+[0-9]{6,14})|[0-9]{6,14}$~"
    },
    "SocialNetwork": {
      "required": true,
      "type": "string",
      "minlength": 10,
      "maxlength": 100
    },
    "CountryCode": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Z]{2}~"
    },
    "Location": {
      "required": false,
      "type": "string",
      "maxlength": 100
    },
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  },
  "send_contact_info_guide": {
    "Specialization": {
      "required": true,
      "type": "string",
      "minlength": 5,
      "maxlength": 60
    }
  },
  "send_contact_info_seeker": {
    "LookingFor": {
      "required": true,
      "type": "string",
      "minlength": 10,
      "maxlength": 255
    }
  },
  "send_contact_email": {
    "Email": {
      "required": true,
      "type": "email",
      "maxlength": 100
    },
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  }
}