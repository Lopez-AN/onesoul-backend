{
  "send_otp_mail": {
    "Email": {
      "required": false,
      "type": "email",
      "maxlength": 100
    },
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  },
  "validate_otp_mail": {
    "OTPCode": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999
    },
    "Email": {
      "required": false,
      "type": "email",
      "maxlength": 100
    },
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  },
  "send_otp_phone": {
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  },
  "validate_otp_phone": {
    "OTPCode": {
      "required": true,
      "type": "integer",
      "min": 0,
      "max": 999999
    },
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  },
  "request_password_reset": {
    "Email": {
      "required": false,
      "type": "email",
      "maxlength": 100
    },
    "UserName": {
      "required": false,
      "type": "string",
      "regex": "~^[a-zA-Z0-9_]{1,15}$~"
    },
    "RecaptchaToken": {
      "required": true,
      "type": "string",
      "regex": "~^[A-Za-z0-9_-]+$~"
    }
  }
}